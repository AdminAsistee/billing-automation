# =============================================================================
# Supabase Connection — Financial Invoice Dashboard
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# .env.local is gitignored and never committed to source control.
#
# All four variables must be set for Supabase to activate.
# If any are missing or invalid, the dashboard will display a
# connection error banner — there is no sample-file fallback.
# =============================================================================

# 1. Your Supabase project URL
#    Found at: https://supabase.com/dashboard/project/_/settings/api → Project URL
SUPA_URL=https://your-project-ref.supabase.co

# 2. Your Supabase anonymous (public) key
#    Found at: https://supabase.com/dashboard/project/_/settings/api → anon / public key
PUBLIC_SUPA_ANON_KEY=your-anon-key-here

# 3. Invoice data table name in your Supabase database
SUPA_DATA_TABLE_NAME=Invoice Data

# 4. Property masterlist table name in your Supabase database
SUPA_MASTERLIST_TABLE_NAME=property_masterlist
